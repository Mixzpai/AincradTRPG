<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);PROFILING</DefineConstants>
    <!-- Terminal.Gui is our fork, built from vendor/Terminal.Gui-2.4.5 (vendor/README.md): change
         its source and build. -p:TgVersion=2.4.5.3 builds against a packed version in
         vendor/packages instead, for an A/B; nothing older than 2.4.5.2 sends only changed cells
         the way the game needs (rule 20). -->
  </PropertyGroup>

  <!-- Always Release, as the package it replaced was: a Debug Terminal.Gui tracks every View's
       disposal (DEBUG_IDISPOSABLE). -->
  <ItemGroup Condition="'$(TgVersion)' == ''">
    <ProjectReference Include="..\vendor\Terminal.Gui-2.4.5\Terminal.Gui\Terminal.Gui.csproj"
                      SetConfiguration="Configuration=Release" />
  </ItemGroup>
  <ItemGroup Condition="'$(TgVersion)' != ''">
    <PackageReference Include="Terminal.Gui" Version="$(TgVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Content\Biomes\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Content\FloorEntries.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Content\Prefabs\**\*.prefab">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
